# Copy to .env.local and fill with your real values. Do not commit .env.local.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Twilio (Phone OTP + all SMS: worker alerts, digests)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Web Push (optional; for worker Fast Match notifications)
# Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Cron (optional; protect /api/cron/* with Bearer token)
# CRON_SECRET=

# AI Image Analysis
# Provider: "gemini" (default, free tier available) or "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# AI_MODEL=gemini-2.0-flash  # optional override (default: gemini-2.0-flash / gpt-4o-mini)

# Maps: Leaflet + OSM tiles (no key required)
